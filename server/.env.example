# `npm run setup` copies this to .env and fills in JWT_SECRET.

# Required, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=12h

PORT=4000

# TLS. Paths are relative to the server/ directory.
TLS_KEY_PATH=../certs/localhost-key.pem
TLS_CERT_PATH=../certs/localhost.pem

# Serve plain HTTP. Only for running behind a reverse proxy that terminates TLS.
# ALLOW_HTTP=true

# Number of reverse proxies in front of the app (for correct client IPs).
# TRUST_PROXY=1

# Extra origins allowed to open a socket, comma separated. Same-origin always works.
# ALLOWED_ORIGINS=https://meet.example.com

# Mesh calls get expensive quickly: each person uploads one stream per peer.
MAX_ROOM_PARTICIPANTS=8
MAX_UPLOAD_MB=25

# How long chat, whiteboard and files survive after the last person leaves.
ROOM_RETENTION_MINUTES=30

# ICE. STUN is enough on most networks; add a TURN server for restrictive NATs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Preferred for coturn: a shared secret (use-auth-secret) instead of the two above,
# so that each user only ever receives a short-lived credential.
# TURN_SECRET=
