{
  "name": "roundtable",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time video conferencing with screen sharing, whiteboard, chat and file sharing",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "dev:mobile:go": "node scripts/dev-mobile.mjs --go",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "selfsigned": "^5.5.0"
  }
}
