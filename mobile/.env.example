# Where the Roundtable backend lives. Copy to .env, then restart Expo.
# Rebuild the Android app after changing it between http:// and https://.
#
# Over USB (run: adb reverse tcp:4000 tcp:4000):
EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Production must use a real HTTPS certificate:
# EXPO_PUBLIC_API_URL=https://meet.example.com
